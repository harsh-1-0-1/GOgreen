# ── Database ──────────────────────────────────────────────
# Local: SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./gogreen.db
# Railway: SQLite is stored on a volume automatically; no change needed.
# If you add a Postgres plugin, use:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Railway: Add a Redis plugin and use its REDIS_URL variable reference.

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Railway: set to https://<your-backend>.up.railway.app/api/v1/auth/google/callback

# ── PayU ──────────────────────────────────────────────────
PAYU_KEY=
PAYU_SALT=

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
# Railway: set to your frontend URL, e.g. https://<your-frontend>.up.railway.app

# ── Frontend (Vite build-time variable) ───────────────────
# Set in Railway frontend service as a build-time variable:
# VITE_API_URL=https://<your-backend>.up.railway.app
