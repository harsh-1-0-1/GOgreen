# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./plantoga.db

# Docker Compose Postgres settings. Change these before deploying publicly.
POSTGRES_DB=plantoga
POSTGRES_USER=plantoga
POSTGRES_PASSWORD=plantoga
POSTGRES_PORT=5433

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
BACKEND_PUBLIC_URL=http://localhost:8000
# Production uses the CloudFront distribution URL:
# BACKEND_PUBLIC_URL=https://d1234abc.cloudfront.net

# ─── CloudFront origin protection ───────────────────────────
# Keep false locally and during the first Render deployment.
REQUIRE_CLOUDFRONT=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CLOUDFRONT_SECRET=

# ─── Auth / JWT ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Cloudinary (image uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AWS S3 & CloudFront CDN ─────────────────────────────────
ENVIRONMENT=development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CDN_BASE_URL=


# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Production: https://d1234abc.cloudfront.net/api/v1/auth/google/callback

# ─── Razorpay Payment Gateway ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# ─── WhatsApp New Order Notifications ────────────────────────
# Uses Meta WhatsApp Cloud API. Leave blank to disable locally.
# Recipient should include country code, for example: 919876543210
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=
WHATSAPP_API_VERSION=v23.0
# Create this approved template in WhatsApp Manager with 5 body variables:
# {{1}} order id, {{2}} amount, {{3}} customer name, {{4}} customer phone, {{5}} item summary
WHATSAPP_ORDER_TEMPLATE_NAME=new_order_received
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=en_US

# ─── Email Order Notifications ───────────────────────────────
# Leave SMTP_HOST blank to disable email locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Plantoga
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Optional internal alert recipient for every new order.
ADMIN_ORDER_EMAIL=

# ─── Frontend / CORS (Render backend + Vercel frontend) ─────
# On Render: set CORS_ORIGINS to your production Vercel URL.
# Multiple exact origins can be comma-separated.
CORS_ORIGINS=http://localhost,http://localhost:5173,https://your-app.vercel.app
# Preview deploys on Vercel (optional but recommended):
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Docker Compose web ports and frontend build-time settings.
BACKEND_PORT=8000
FRONTEND_PORT=80
VITE_API_BASE_URL=/api/v1
VITE_CDN_BASE_URL=
VITE_CORPORATE_INQUIRY_ENDPOINT=

# ─── Logging ─────────────────────────────────────────────────
# Set to true for structured JSON logs (recommended in production)
LOG_JSON=false
# Log queries slower than this threshold (ms)
SLOW_QUERY_MS=100
# Set to true for SQLAlchemy echo mode
DEBUG=false
