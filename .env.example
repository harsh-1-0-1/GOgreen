# ─── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./plantoga.db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
BACKEND_PUBLIC_URL=http://localhost:8000
# Render production example:
# BACKEND_PUBLIC_URL=https://your-app.onrender.com

# ─── Auth / JWT ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Cloudinary (image uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── PayU Payment Gateway ───────────────────────────────────
PAYU_KEY=
PAYU_SALT=

# ─── Frontend / CORS (Render backend + Vercel frontend) ─────
# On Render: set CORS_ORIGINS to your production Vercel URL.
# Multiple exact origins can be comma-separated.
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Preview deploys on Vercel (optional but recommended):
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ─── Logging ─────────────────────────────────────────────────
# Set to true for structured JSON logs (recommended in production)
LOG_JSON=false
# Log queries slower than this threshold (ms)
SLOW_QUERY_MS=100
# Set to true for SQLAlchemy echo mode
DEBUG=false
