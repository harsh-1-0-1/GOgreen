# Local backend (via Vite proxy — same origin, cookies work):
VITE_API_BASE_URL=/api/v1

# Local backend (direct, no proxy):
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Vercel production — point at your Render backend (set in Vercel dashboard):
# Production (CloudFront in front of Render):
# VITE_API_BASE_URL=https://d1234abc.cloudfront.net/api/v1

# Razorpay Checkout
VITE_RAZORPAY_KEY_ID=

# Corporate/Bulk Inquiry Endpoint
# Default: /corporate-inquiries (uses VITE_API_BASE_URL client)
# Override with full URL for external webhook if needed
VITE_CORPORATE_INQUIRY_ENDPOINT=

# Contact information
VITE_WHATSAPP_NUMBER=917083883105
VITE_SUPPORT_PHONE=917083883105
